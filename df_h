  - name: Run one-liner df and append to flat file
  shell: |
    df -Th | awk -v d="$(date '+%Y-%m-%d %H:%M:%S')" -v h="$(hostname -s)" '
    NR==1 {next}
    {
        fs=$1; type=$2; size=$3; used=$4; avail=$5; usepct=$6; 
        mount=$7; for(i=8;i<=NF;i++) mount=mount" "$i;
        gsub(/%/,"",usepct);
        printf "%s|%s|%s|%s|%s|%s|%s|%s|%s\n", d, h, fs, type, size, used, avail, usepct, mount
