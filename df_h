  #!/bin/bash
# File: /usr/local/bin/df_custom.sh
# Make it executable: chmod +x /usr/local/bin/df_custom.sh

HOSTNAME=$(hostname -s)
LOAD_DATE=$(date '+%Y-%m-%d %H:%M:%S')

echo "load_date|server_name|filesystem|type|size|used|avail|use_pct|mounted_on"

# Run df -Th and format output
df -Th | tail -n +2 | while read -r line; do
    # Parse the line safely
    FS=$(echo "$line" | awk '{print $1}')
    TYPE=$(echo "$line" | awk '{print $2}')
    SIZE=$(echo "$line" | awk '{print $3}')
    USED=$(echo "$line" | awk '{print $4}')
    AVAIL=$(echo "$line" | awk '{print $5}')
    USEPCT=$(echo "$line" | awk '{print $6}' | tr -d '%')
    MOUNT=$(echo "$line" | awk '{for(i=7;i<=NF;i++) printf "%s ", $i; print ""}' | sed 's/ *$//')

    echo "${LOAD_DATE}|${HOSTNAME}|${FS}|${TYPE}|${SIZE}|${USED}|${AVAIL}|${USEPCT}|${MOUNT}"
done
